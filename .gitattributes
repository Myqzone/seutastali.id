# Auto detect text files and normalize line endings to LF
* text=auto

# PHP Files
*.php text eol=lf
*.phps text eol=lf

# JavaScript / JSON
*.js text eol=lf
*.json text eol=lf
*.jsonc text eol=lf

# CSS / SCSS
*.css text eol=lf
*.scss text eol=lf
*.sass text eol=lf
*.less text eol=lf

# HTML / Templates
*.html text eol=lf
*.htm text eol=lf
*.phtml text eol=lf

# Markdown
*.md text eol=lf
*.markdown text eol=lf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# YAML
*.yaml text eol=lf
*.yml text eol=lf

# XML
*.xml text eol=lf

# Composer
composer.json text eol=lf
composer.lock text eol=lf

# Git
.gitignore text eol=lf
.gitattributes text eol=lf

# Binary files
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.ico binary
*.mov binary
*.mp4 binary
*.mp3 binary
*.gz binary
*.zip binary
*.7z binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
