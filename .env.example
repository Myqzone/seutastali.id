# ============================================================
# Klinik Samiaji - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit your .env file to version control
# ============================================================

# Application
APP_ENV=production

# Application URLs
# Klinik Samiaji uses dual-domain architecture:
# - Landing Page: kliniksamiaji.id (public website)
# - Dashboard: app.kliniksamiaji.id (internal management)

# For Landing Page (kliniksamiaji.id):
BASE_URL=https://kliniksamiaji.id/
STATIC_URL=https://kliniksamiaji.id/
MAIN_SITE_URL=https://kliniksamiaji.id/
IS_APP_SUBDOMAIN=false

# For Dashboard (app.kliniksamiaji.id):
# BASE_URL=https://app.kliniksamiaji.id/
# STATIC_URL=https://kliniksamiaji.id/
# MAIN_SITE_URL=https://kliniksamiaji.id/
# IS_APP_SUBDOMAIN=true

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=u370308533_klinik_samiaji
DB_PORT=3306


